DirectoryIndex index.html

# Serve Next.js static export cleanly on Apache / cPanel
Options -MultiViews -Indexes
RewriteEngine On

# HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Apex host (no www)
RewriteCond %{HTTP_HOST} ^www\.kitumcavesafaris\.com$ [NC]
RewriteRule ^ https://kitumcavesafaris.com%{REQUEST_URI} [L,R=301]

# Drop index.html so /about/index.html is not a second URL
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^(.+)/index\.html$ /$1/ [R=301,L]

# Trailing slash on pages (skip real files such as .xml, .css, images)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[a-z0-9]{2,8}$ [NC]
RewriteRule ^(.*)$ /$1/ [R=301,L]

# The repository is checked out into the web root, so everything that is not
# part of the static export sits alongside it and would otherwise be served.
# These rules must stay above the "real file" rule below, which ends matching.
RewriteRule ^(src|server|prisma|scripts|node_modules|out|\.next|\.github)(/|$) - [F,L]
RewriteRule ^(package(-lock)?\.json|tsconfig\.json|next\.config\.[a-z]+|postcss\.config\.[a-z]+|eslint\.config\.[a-z]+|components\.json|README\.md|AGENTS\.md|CLAUDE\.md)$ - [F,L]

# Dotfiles, except the ACME challenge directory AutoSSL needs
RewriteRule (^|/)\.(?!well-known) - [F,L]

# If the request is a real file or directory, serve it
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Unknown paths are 404s — do not serve the homepage (that created duplicate URLs)
ErrorDocument 404 /404.html
