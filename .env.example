DATABASE_URL="file:./dev.db"

# Flutterwave Payment Gateway (server-side only)
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key
FLUTTERWAVE_ENCRYPTION_KEY=your_flutterwave_encryption_key
FLUTTERWAVE_WEBHOOK_SECRET=your_webhook_secret

# Email (for receipts and notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@kitumcavesafaris.com
SMTP_PASS=your_email_password
SMTP_FROM=info@kitumcavesafaris.com

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI Assistant (optional - uses built-in responses if not set)
OPENAI_API_KEY=
